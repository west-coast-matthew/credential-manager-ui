# Copy to .env.local and adjust. Restart `npm run dev` after changing anything here.

# API location. Leave empty to call /api on the same origin — in development the Vite dev
# server proxies /api to the credential-manager-api server (vite.config.ts, VITE_API_PROXY_TARGET).
# Set it only to call the API cross-origin; that origin must then be listed in the API's CORS_ORIGIN.
# VITE_API_BASE_URL=http://127.0.0.1:3001

# Where the dev server proxies /api to (default http://127.0.0.1:3001).
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Lock the vault after this many minutes without mouse or keyboard activity. 0 = never.
VITE_AUTO_LOCK_MINUTES=15
